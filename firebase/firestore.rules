rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check admin claim
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    match /photos/{photoId} {
      // Anyone can read approved public photos
      allow read: if resource.data.status == 'approved' || isAdmin();

      // Visitors can create photos with validated constraints
      allow create: if request.resource.data.uploaderName is string
                    && request.resource.data.uploaderName.size() > 0
                    && request.resource.data.uploaderName.size() <= 60
                    && request.resource.data.imageUrl is string
                    && request.resource.data.category is string
                    && (request.resource.data.status in ['approved', 'pending'])
                    && request.resource.data.createdAt is string;

      // Only authenticated admins can modify (edit caption, change status, feature) or delete photos
      allow update, delete: if isAdmin();
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
